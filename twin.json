{
  "schemaVersion": 4,
  "system": {
    "id": "blog",
    "name": "blog",
    "summary": "Damit Nils längere Gedanken veröffentlichen kann: Beiträge mit RSS unter blog.ecke.lt.",
    "repository": "eckelt/blog",
    "visibility": "public",
    "url": "https://blog.ecke.lt/",
    "specs": [
      "posts",
      "feeds-seo",
      "shared-design",
      "deploy"
    ]
  },
  "containers": [
    {
      "id": "site",
      "name": "blog.ecke.lt Website",
      "kind": "app",
      "technology": "Astro, Cloudflare Workers Static Assets",
      "summary": "Statische Website aus Markdown-Beiträgen mit RSS und Sitemap; Gestaltung und Diagramme aus dem ecke.lt Design-System.",
      "path": "src/",
      "url": "https://blog.ecke.lt/",
      "visibility": "public",
      "specs": [
        "posts",
        "feeds-seo",
        "shared-design",
        "deploy"
      ],
      "interfaces": [
        {
          "id": "site",
          "direction": "provides",
          "contractRef": "blog:site@1",
          "protocol": "HTTPS HTML",
          "summary": "blog.ecke.lt: Übersicht, /blog/<id>/, /rss.xml, /sitemap-index.xml, /robots.txt"
        },
        {
          "id": "profile-site",
          "direction": "consumes",
          "contractRef": "nils.ecke.lt:site@1",
          "protocol": "HTTPS Hyperlink",
          "relation": "links-to",
          "summary": "Profil-Link auf nils.ecke.lt"
        },
        {
          "id": "booking-page",
          "direction": "consumes",
          "contractRef": "booking:booking-page@1",
          "protocol": "HTTPS Hyperlink",
          "relation": "links-to",
          "summary": "„Termin buchen“ auf book.ecke.lt/30min"
        },
        {
          "id": "design-system-styles",
          "direction": "consumes",
          "contractRef": "ecke-design-system:styles@1",
          "protocol": "HTTPS CSS",
          "relation": "imports",
          "summary": "bindet /v1/styles.css von ecke-design-system ein (Tokens, Schriften, Grundstile) statt eigener Kopie"
        },
        {
          "id": "design-system-mermaid",
          "direction": "consumes",
          "contractRef": "ecke-design-system:mermaid@1",
          "protocol": "HTTPS JavaScript",
          "relation": "imports",
          "summary": "rendert Diagramme mit /v1/mermaid.js statt eigenem Skript"
        }
      ],
      "adrs": [
        "docs/adr/2026-09-01-alle-apps-nutzen-design-system.md",
        "docs/adr/2026-10-19-design-ecke-lt.md",
        "docs/adr/2026-10-17-deploy-per-ci.md"
      ]
    }
  ]
}
