---
import { NAV } from "../consts";
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <img src="/hw-monogram.png" alt="" class="brand-mark" />
      <span class="brand-word">hackers &amp; wizards</span>
    </a>
    <nav aria-label="Hauptnavigation">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: item.href === path }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    padding: 1.75rem 0 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .brand-mark {
    height: 1.6rem;
    width: auto;
    display: block;
  }
  .brand-word {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--dur, 0.12s);
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
  }
</style>
