---
import { PROFILE_URL } from "../consts";
const year = new Date().getFullYear();
---

<footer class="wrap">
  <img src="/hw-monogram.png" alt="" class="footer-mark" />
  <span>© {year} Hackers &amp; Wizards</span>
  <span class="sep">·</span>
  <a href={`${PROFILE_URL}/impressum/`}>Impressum</a>
  <span class="sep">·</span>
  <a href={`${PROFILE_URL}/datenschutz/`}>Datenschutz</a>
</footer>

<style>
  footer {
    padding: 3rem 0;
    margin-top: 2rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  footer a {
    color: var(--muted);
    transition: color 0.12s;
  }
  footer a:hover {
    color: var(--accent);
  }
  .sep {
    opacity: 0.6;
  }
  .footer-mark {
    height: 1.1rem;
    width: auto;
    opacity: 0.7;
    margin-right: 0.5rem;
  }
</style>
